<%- include('head') %><section class="section studio editor"><a class="text-link" href="/owner">← Your studio</a><div class="section-heading"><div><p class="eyebrow"><%= post.sample?'SAMPLE · ':'' %><%= post.published?'PUBLISHED':'DRAFT' %></p><h1>The finishing <em>touches.</em></h1></div><a class="button outline" href="/owner/preview/<%= post.id %>">Preview <svg class="arrow-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12"/></svg></a></div><% if(notice){ %><p class="notice" role="status"><%= notice %></p><% } %><form class="panel" action="/owner/design/<%= post.id %>" method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><h2>Tell the story</h2><label>Design title<input name="title" value="<%= post.title %>" maxlength="150" required></label><label>Description<textarea name="description" rows="4" maxlength="5000"><%= post.description %></textarea></label><label>Step-by-step instructions (optional, one step per line)<textarea name="steps" rows="5" maxlength="10000"><%= post.steps %></textarea></label><div class="form-grid three"><% ['color','style','occasion'].forEach(k=>{ %><label><%= k[0].toUpperCase()+k.slice(1) %><input name="<%= k %>" value="<%= post[k] %>" maxlength="40" placeholder="<%= k==='color'?'Pink':k==='style'?'Floral':'Everyday' %>"></label><% }) %></div><label class="check"><input type="checkbox" name="affiliate" <%= post.affiliate?'checked':'' %>> Show affiliate link disclosure</label><button>Save <%= post.published?'changes':'draft' %></button><p class="fine">Save this form before uploading or editing other sections below.</p></form><section class="panel"><h2>Your photos</h2><p>Upload from your phone or computer. Images are resized and converted to WebP; location metadata is removed. Up to 20 photos, 12 MB each. If HEIC is unsupported, export as JPEG first.</p><form action="/owner/design/<%= post.id %>/photos?csrf=<%= csrf %>" method="post" enctype="multipart/form-data"><label>Choose photos<input type="file" name="photos" accept="image/jpeg,image/png,image/webp,image/heic,image/heif,image/avif" multiple required></label><button>Upload photos</button></form><p class="fine">Lower order numbers appear first. The first image is your cover. Save each photo’s changes.</p><div class="photo-edit-grid"><% post.photos.forEach(f=>{ %><form action="/owner/design/<%= post.id %>/photo/<%= f.id %>" method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><img src="<%= f.url.startsWith('/art-')?'/assets'+f.url:f.url %>" alt="<%= f.alt %>" width="280" height="300"><label>Image description<input name="alt" value="<%= f.alt %>" maxlength="500" placeholder="Describe the nail colors and details" required></label><label>Order (first = cover)<input name="position" type="number" value="<%= f.position %>" min="-1000" max="1000"></label><div class="button-row"><button>Save photo</button><button class="outline danger" name="remove" value="1" formnovalidate data-confirm="Remove this photo permanently?">Remove</button></div></form><% }) %></div></section><section class="panel"><h2>Supplies I used</h2><p>Add real retailer addresses. Visitors will see a clearly labeled external purchase link.</p><% post.supplies.forEach(s=>{ %><form action="/owner/design/<%= post.id %>/supply" method="post" class="supply-editor"><%- include('supply-form',{s}) %><button>Save supply</button></form><form action="/owner/design/<%= post.id %>/supply/<%= s.id %>/delete" method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="outline danger" data-confirm="Remove this supply?">Remove supply</button></form><% }) %><details><summary>＋ Add a supply</summary><form action="/owner/design/<%= post.id %>/supply" method="post"><%- include('supply-form',{s:{}}) %><button>Add supply</button></form></details></section><section class="panel"><h2>Ready to share?</h2><p>Save your changes and preview your design first. Its page address stays the same after editing.</p><form action="/owner/design/<%= post.id %>/publish" method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><label class="check"><input type="checkbox" name="notify" <%= !emailReady||post.notified||post.sample?'disabled':'' %>> Notify confirmed subscribers <%= post.notified?'(already queued; cannot send twice)':'' %></label><% if(!emailReady){ %><p class="preview-note">Email preview mode: publishing works, but notifications require an email connection.</p><% } %><button><%= post.published?'Keep published':'Publish design' %> <svg class="arrow-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12"/></svg></button></form><% if(post.published){ %><form action="/owner/design/<%= post.id %>/unpublish" method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="outline">Unpublish to draft</button></form><% } %><form action="/owner/design/<%= post.id %>/delete" method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="outline danger" data-confirm="Permanently delete this design and its photos? This cannot be undone.">Delete design permanently</button></form></section></section><%- include('foot') %>
