<input type="hidden" name="csrf" value="<%= csrf %>"><% if(s.id){ %><input type="hidden" name="supply_id" value="<%= s.id %>"><% } %><div class="form-grid"><label>Product name<input name="name" value="<%= s.name||'' %>" required maxlength="150"></label><label>Brand<input name="brand" value="<%= s.brand||'' %>" maxlength="100"></label><label>Shade or color<input name="shade" value="<%= s.shade||'' %>" maxlength="100"></label><label>Retailer purchase address<input name="url" type="url" value="<%= s.url||'' %>" required placeholder="Paste the real product page address"></label></div><label>Notes (optional)<textarea name="notes" maxlength="1000"><%= s.notes||'' %></textarea></label>
