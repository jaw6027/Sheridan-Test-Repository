<%- include('head') %><section class="page-intro"><p class="eyebrow">YOUR INSPIRATION LIBRARY</p><h1>The <em>collection.</em></h1><p>A color, a mood, a tiny work of art. Find your next favorite.</p></section><section class="section gallery-section"><form class="filters" action="/gallery"><label>Search<input name="q" value="<%= filters.q||'' %>" placeholder="Find a design…"></label><% for(const key of ['color','style','occasion']) { %><label><%= key[0].toUpperCase()+key.slice(1) %><select aria-label="<%= key[0].toUpperCase()+key.slice(1) %>" name="<%= key %>"><option value="">All <%= key %>s</option><% [...new Set(all.map(p=>p[key]).filter(Boolean))].sort().forEach(v=>{ %><option <%= filters[key]===v?'selected':'' %>><%= v %></option><% }) %></select></label><% } %><button>Find designs</button><a href="/gallery">Reset</a></form><p class="fine"><%= posts.length %> designs · Sample illustrations are labeled and are not the owner’s work.</p><div class="card-grid"><% posts.forEach(post=>{ %><%- include('card',{post}) %><% }) %></div><% if(!posts.length){ %><p class="empty">No designs match just yet. Try another color or clear the filters.</p><% } %></section><%- include('newsletter') %><%- include('foot') %>
