<%- include('head') %><article class="design-detail section"><a class="text-link" href="/gallery">← Back to the collection</a><% if(preview){ %><p class="notice">Private owner preview · <%= post.published?'Published':'Draft, visible only to you' %> <a href="/owner/design/<%= post.id %>">Return to editor</a></p><% } %><div class="detail-heading"><p class="eyebrow"><%= post.style %> · <%= post.color %> · <%= post.occasion %></p><h1><%= post.title %></h1><p><%= post.published_at?new Date(post.published_at).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}):'Unpublished draft' %></p><% if(post.sample){ %><p class="notice">Sample design · These are placeholder illustrations, not photographs of the owner’s nail art. No product endorsements or supplies are implied.</p><% } %></div><div class="photo-grid"><% post.photos.forEach((f,i)=>{ %><button class="photo-button <%= i===0?'cover-photo':'' %>" type="button" data-enlarge="<%= f.url.startsWith('/art-')?'/assets'+f.url:f.url %>" data-alt="<%= f.alt %>" aria-label="Enlarge photo: <%= f.alt %>"><img src="<%= f.url.startsWith('/art-')?'/assets'+f.url:f.url %>" alt="<%= f.alt %>" width="1000" height="1100" <%= i?'loading=lazy':'' %>><span>Enlarge <svg class="arrow-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12"/></svg></span></button><% }) %></div><div class="detail-body"><div><h2>The little details</h2><p class="multiline"><%= post.description %></p><% if(post.steps){ %><h2>Make it your own</h2><ol class="steps"><% post.steps.split('\n').filter(Boolean).forEach(step=>{ %><li><%= step %></li><% }) %></ol><% } %><button type="button" class="outline" id="share" data-url="<%= canonical %>">Share this design <svg class="arrow-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12"/></svg></button><p id="share-status" role="status"></p></div><aside class="supplies"><p class="eyebrow">THE TOOLKIT</p><h2>Supplies I used</h2><% if(post.affiliate){ %><p class="fine">Affiliate disclosure: I may earn a commission when you buy through these links, at no extra cost to you.</p><% } %><% if(!post.supplies.length){ %><p><%= post.sample?'Sample illustration—no real products used.':'Supply details will be added soon.' %></p><% } %><% post.supplies.forEach(s=>{ %><div class="supply"><h3><%= s.name %></h3><p><%= s.brand %><%= s.shade?' · '+s.shade:'' %></p><p><%= s.notes %></p><a href="<%= s.url %>" target="_blank" rel="noopener noreferrer <%= post.affiliate?'sponsored':'' %>">Buy from retailer <svg class="arrow-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12"/></svg> <span class="fine">(external link)</span></a></div><% }) %></aside></div></article><%- include('newsletter') %><%- include('foot') %>
