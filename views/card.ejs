<article class="design-card"><a href="/design/<%= post.slug %>" class="card-image"><% if(post.photos[0]){ %><img src="<%= post.photos[0].url.startsWith('/art-')?'/assets'+post.photos[0].url:post.photos[0].url %>" alt="<%= post.photos[0].alt %>" loading="lazy" width="640" height="760"><% } %><span class="image-tag"><%= post.sample?'SAMPLE ILLUSTRATION':post.style||'NAIL ART' %></span><span class="card-arrow"><svg class="arrow-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12"/></svg></span></a><div class="card-meta"><%= post.style || 'Nail art' %> <span>·</span> <%= post.color %></div><h3><a href="/design/<%= post.slug %>"><%= post.title %></a></h3><p><%= post.description.slice(0,105) %></p></article>
