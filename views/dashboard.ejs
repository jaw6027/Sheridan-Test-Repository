<%- include('head') %><section class="section studio"><div class="section-heading"><div><p class="eyebrow">OWNER DASHBOARD</p><h1>Your <em>studio.</em></h1><p>Create something lovely. Share it when you’re ready.</p></div><div class="dashboard-actions"><form method="post" action="/owner/new"><input type="hidden" name="csrf" value="<%= csrf %>"><button>＋ New design</button></form><button type="button" class="outline">test button</button></div></div><div class="notice"><strong><%= emailReady?'Email integration configured':'Email preview mode' %></strong> · <%= subscribers %> confirmed subscribers.<% if(!emailReady){ %> Connect Resend, EMAIL_FROM, and PUBLIC_URL to enable subscriptions and notifications.<% } %><% mail.forEach(m=>{ %> <span><%= m.count %> emails <%= m.status==='sent'?'accepted by provider':m.status %>.</span><% }) %> “Accepted” does not prove inbox delivery. Jobs marked needs-review require provider reconciliation before resending.</div><div class="post-list"><% posts.forEach(p=>{ %><a class="post-row" href="/owner/design/<%= p.id %>"><% if(p.photos[0]){ %><img src="<%= p.photos[0].url.startsWith('/art-')?'/assets'+p.photos[0].url:p.photos[0].url %>" alt="" width="64" height="72"><% } %><div><h3><%= p.title %></h3><p><%= p.sample?'Sample · ':'' %><%= p.published?'Published':'Draft' %><%= p.notified?' · Notification already queued':'' %></p></div><span>Edit <svg class="arrow-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12"/></svg></span></a><% }) %></div><details class="settings"><summary>Your brand & profile</summary><form action="/owner/settings" method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><label>Brand name<input name="brand" value="<%= brand.brand %>" required maxlength="80"></label><label>Your biography<textarea name="bio" rows="5"><%= brand.bio %></textarea></label><div class="form-grid"><label>Instagram address<input type="url" name="instagram" value="<%= brand.instagram %>" placeholder="https://instagram.com/yourname"></label><label>Pinterest address<input type="url" name="pinterest" value="<%= brand.pinterest %>" placeholder="https://pinterest.com/yourname"></label></div><label>Featured homepage design<select name="featured"><option value="">Latest design</option><% posts.filter(p=>p.published).forEach(p=>{ %><option value="<%= p.id %>" <%= brand.featured===p.id?'selected':'' %>><%= p.title %></option><% }) %></select></label><button>Save brand settings</button></form></details><form action="/owner/logout" method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="outline">Log out</button></form></section><%- include('foot') %>
