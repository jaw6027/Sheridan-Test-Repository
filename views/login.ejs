<%- include('head') %><section class="login-panel"><p class="eyebrow">JUST FOR YOU</p><h1>Your creative<br><em>studio.</em></h1><p>A private place to bring your next design to life.</p><% if(!configured){ %><div class="notice">Owner login is not configured. In the project terminal, run <code>npm run owner:setup</code> to choose your password, then restart the app. Public visitors cannot register as an owner.</div><% }else{ %><form action="/owner/login" method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><label>Owner password<input type="password" name="password" autocomplete="current-password" required maxlength="512"></label><% if(error){ %><p class="error" role="alert"><%= error %></p><% } %><button>Enter your studio <svg class="arrow-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12"/></svg></button></form><% } %></section><%- include('foot') %>
