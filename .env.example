PORT=3000
# Use a persistent disk mounted at this path in production.
DATA_DIR=./data
PUBLIC_URL=http://localhost:3000
# Run npm run owner:setup to generate SESSION_SECRET and OWNER_PASSWORD_HASH.
SESSION_SECRET=
OWNER_PASSWORD_HASH=
# Optional until launch. Verify your sender domain in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Set to production behind an HTTPS reverse proxy at launch.
NODE_ENV=development
